{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JakeRoxs/xcom2-aaml/eng/qualification/runner-config.schema.json",
  "title": "AAML protected qualification runner configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenario", "command", "timeoutSeconds", "statePaths", "logPaths"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenario": { "enum": ["windows-game", "linux-proton", "steam-mutation"] },
    "command": { "type": "string", "minLength": 1 },
    "arguments": { "type": "array", "items": { "type": "string" }, "default": [] },
    "timeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 2400 },
    "statePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "policy"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "path": { "type": "string", "minLength": 1 },
          "policy": { "enum": ["preserve", "rollback"] }
        }
      }
    },
    "logPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
