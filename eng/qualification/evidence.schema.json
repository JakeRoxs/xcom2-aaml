{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JakeRoxs/xcom2-aaml/eng/qualification/evidence.schema.json",
  "title": "AAML protected qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenario", "result", "startedAtUtc", "completedAtUtc", "artifact", "runner", "command", "state", "logs", "restoration"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenario": { "enum": ["windows-game", "linux-proton", "steam-mutation"] },
    "result": { "enum": ["passed", "failed"] },
    "failure": { "type": ["string", "null"] },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "completedAtUtc": { "type": "string", "format": "date-time" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveFile", "archiveSha256", "rid", "repository", "commit", "version", "treeBeforeSha256", "treeAfterSha256"],
      "properties": {
        "archiveFile": { "type": "string" },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "rid": { "enum": ["win-x64", "linux-x64"] },
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "version": { "type": "string", "minLength": 1 },
        "treeBeforeSha256": { "$ref": "#/$defs/hashMap" },
        "treeAfterSha256": { "$ref": "#/$defs/hashMap" }
      }
    },
    "runner": {
      "type": "object",
      "required": ["os", "machine", "configSha256"],
      "properties": {
        "os": { "type": "string" },
        "machine": { "type": "string" },
        "configSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "command": {
      "type": "object",
      "required": ["file", "arguments", "timeoutSeconds", "exitCode", "timedOut"],
      "properties": {
        "file": { "type": "string" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "exitCode": { "type": ["integer", "null"] },
        "timedOut": { "type": "boolean" }
      }
    },
    "state": {
      "type": "object",
      "required": ["before", "afterScenario", "afterRestoration"],
      "properties": {
        "before": { "$ref": "#/$defs/stateMap" },
        "afterScenario": { "$ref": "#/$defs/stateMap" },
        "afterRestoration": { "$ref": "#/$defs/stateMap" }
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "evidencePath", "sha256"],
        "properties": {
          "source": { "type": "string" },
          "evidencePath": { "type": "string" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "restoration": {
      "type": "object",
      "required": ["attempted", "complete", "mismatches"],
      "properties": {
        "attempted": { "type": "boolean" },
        "complete": { "type": "boolean" },
        "mismatches": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hashMap": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sha256" } },
    "stateMap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["exists", "treeSha256"],
        "properties": {
          "exists": { "type": "boolean" },
          "treeSha256": { "$ref": "#/$defs/hashMap" }
        }
      }
    }
  }
}
