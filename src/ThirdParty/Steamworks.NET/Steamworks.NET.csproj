<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Steamworks.NET</AssemblyName>
    <RootNamespace>Steamworks</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <SteamworksPlatform Condition="'$(SteamworksPlatform)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">Windows</SteamworksPlatform>
    <SteamworksPlatform Condition="'$(SteamworksPlatform)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">Linux</SteamworksPlatform>
    <SteamworksPlatform Condition="'$(SteamworksPlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</SteamworksPlatform>
    <SteamworksPlatform Condition="'$(SteamworksPlatform)' == ''">Linux</SteamworksPlatform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SteamworksPlatform)' == 'Windows'">
    <DefineConstants>$(DefineConstants);STEAMWORKS_WIN;STEAMWORKS_X64</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SteamworksPlatform)' == 'Linux'">
    <DefineConstants>$(DefineConstants);STEAMWORKS_LIN_OSX;STEAMWORKS_X64</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Runtime/**/*.cs" />
  </ItemGroup>
</Project>
