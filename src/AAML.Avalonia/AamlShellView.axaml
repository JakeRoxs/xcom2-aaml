<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Zafiro.UI.Shell;assembly=Zafiro.UI"
             xmlns:zac="clr-namespace:Zafiro.Avalonia.Controls;assembly=Zafiro.Avalonia"
             xmlns:nav="clr-namespace:Zafiro.Avalonia.Controls.Navigation;assembly=Zafiro.Avalonia"
             xmlns:sections="clr-namespace:Zafiro.UI.Navigation.Sections;assembly=Zafiro.UI"
             xmlns:local="using:AAML.Avalonia"
             x:Class="AAML.Avalonia.AamlShellView"
             x:DataType="shell:IHierarchicalShell">
  <UserControl.Resources>
    <DataTemplate x:Key="ShellRailItemTemplate" DataType="sections:ISection">
      <StackPanel Classes="shell-rail-item" MinHeight="52" Orientation="Horizontal" Spacing="10" ToolTip.Tip="{Binding FriendlyName}">
        <Viewbox Width="{DynamicResource AamlShellIconSize}" Height="{DynamicResource AamlShellIconSize}" VerticalAlignment="Center">
          <ContentControl Content="{Binding Icon}" />
        </Viewbox>
        <TextBlock IsVisible="{Binding IsRailOpen, RelativeSource={RelativeSource AncestorType=local:AamlShellView}}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding FriendlyName}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.shell-rail">
      <Setter Property="Width" Value="200" />
    </Style>
    <Style Selector="Border.shell-rail.compact">
      <Setter Property="Width" Value="60" />
    </Style>
    <Style Selector="Border.shell-rail StackPanel.shell-rail-item">
      <Setter Property="Margin" Value="10,2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.shell-rail.compact StackPanel.shell-rail-item">
      <Setter Property="Margin" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.shell-rail Grid.shell-game-item">
      <Setter Property="Margin" Value="10,2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.shell-rail.compact Grid.shell-game-item">
      <Setter Property="Margin" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Image.shell-game-icon">
      <Setter Property="Width" Value="{DynamicResource AamlShellIconSize}" />
      <Setter Property="Height" Value="{DynamicResource AamlShellIconSize}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.9" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.shell-game-icon-button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.shell-game-icon-button:pointerover Image.shell-game-icon">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="Border.shell-game-challenge-badge">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="TextElement.Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="-2,-2,0,0" />
    </Style>
    <Style Selector="Border.shell-game-challenge-badge TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.shell-game-selector">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BoxShadow" Value="0 6 16 #66000000" />
    </Style>
    <Style Selector="Button.shell-game-option">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.shell-game-option:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    <Style Selector="Image.shell-game-option-icon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="Auto,*">
    <Border Classes="shell-rail"
            Classes.compact="{Binding !IsRailOpen, RelativeSource={RelativeSource AncestorType=local:AamlShellView}}">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0"
              Classes="shell-game-item"
              ColumnDefinitions="Auto,*">
          <Button x:Name="GameIconButton"
                  Grid.Column="0"
                  Classes="shell-game-icon-button"
                  AutomationProperties.AutomationId="ShellActiveGameIcon"
                  AutomationProperties.Name="{Binding ActiveGameIconTooltip, RelativeSource={RelativeSource AncestorType=local:AamlShellView}}"
                  ToolTip.Tip="{Binding ActiveGameIconTooltip, RelativeSource={RelativeSource AncestorType=local:AamlShellView}}"
                  Click="OnGameIconButtonClicked">
            <Grid>
              <Image Classes="shell-game-icon"
                     Source="{Binding ActiveGameIcon, RelativeSource={RelativeSource AncestorType=local:AamlShellView}}" />
              <Border Classes="shell-game-challenge-badge"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      IsVisible="{Binding IsChallengeMode, RelativeSource={RelativeSource AncestorType=local:AamlShellView}}">
                <TextBlock Classes="badge" Text="Challenge" />
              </Border>
            </Grid>
          </Button>
          <TextBlock Grid.Column="1"
                     Classes="shell-game-name"
                     Margin="10,0,0,0"
                     IsVisible="{Binding IsRailOpen, RelativeSource={RelativeSource AncestorType=local:AamlShellView}}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding ActiveGameDisplayName, RelativeSource={RelativeSource AncestorType=local:AamlShellView}}" />
          <Popup x:Name="GameSelectorPopup"
                 PlacementTarget="{Binding ElementName=GameIconButton}"
                 Placement="Right"
                 Opened="OnGameSelectorPopupOpened"
                 Closed="OnGameSelectorPopupClosed">
            <Border Classes="shell-game-selector" Padding="6">
              <ItemsControl ItemsSource="{Binding GameOptions, RelativeSource={RelativeSource AncestorType=local:AamlShellView}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="local:GameOption">
                    <Button Classes="shell-game-option"
                            Tag="{Binding Variant}"
                            Click="OnGameOptionClicked">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Classes="shell-game-option-icon" Source="{Binding Icon}" />
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Popup>
        </Grid>
        <zac:SectionStrip Grid.Row="1"
                          Orientation="Vertical"
                          ItemTemplate="{StaticResource ShellRailItemTemplate}"
                          IconSize="{DynamicResource AamlShellIconSize}"
                          ItemPadding="4,8"
                          ItemSpacing="2"
                          Padding="2"
                          Sections="{Binding RootLevel.Sections}"
                          SelectedSection="{Binding RootLevel.SelectedSection.Value, Mode=TwoWay}" />
        <Panel Grid.Row="2">
          <ToggleButton AutomationProperties.AutomationId="ShellRailCollapseButton" Classes="shell-icon"
                        AutomationProperties.Name="Collapse navigation"
                        Margin="8"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsRailOpen, RelativeSource={RelativeSource AncestorType=local:AamlShellView}}"
                        IsChecked="{Binding IsRailOpen, RelativeSource={RelativeSource AncestorType=local:AamlShellView}, Mode=TwoWay}"
                        Content="☰"
                        ToolTip.Tip="Switch to icon-only navigation" />
          <ToggleButton AutomationProperties.AutomationId="ShellRailExpandButton" Classes="shell-icon"
                        AutomationProperties.Name="Expand navigation"
                        Margin="8"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding !IsRailOpen, RelativeSource={RelativeSource AncestorType=local:AamlShellView}}"
                        IsChecked="{Binding IsRailOpen, RelativeSource={RelativeSource AncestorType=local:AamlShellView}, Mode=TwoWay}"
                        Content="☰"
                        ToolTip.Tip="Show navigation labels" />
        </Panel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <ItemsControl ItemsSource="{Binding ChildLevels.Value}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="shell:SectionLevel">
              <zac:SectionStrip Orientation="Horizontal"
                                Sections="{Binding Sections}"
                                SelectedSection="{Binding SelectedSection.Value, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Frame Grid.Row="1"
               HeaderPadding="0"
               Padding="0"
               Content="{Binding SelectedSection.Value.Navigator.Content^}"
               BackCommand="{Binding SelectedSection.Value.Navigator.Back}">
          <Interaction.Behaviors>
            <nav:AutoHeaderFooterBehavior />
          </Interaction.Behaviors>
        </Frame>

    </Grid>
  </Grid>
</UserControl>
