<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AAML.Avalonia" x:Class="AAML.Avalonia.ModCleanupView" x:DataType="local:ModCleanupViewModel" AutomationProperties.AutomationId="CleanupPage">
  <Grid Margin="24" RowDefinitions="Auto,16,Auto,12,Auto,12,*">
    <StackPanel><TextBlock Classes="title" Text="Cleanup"/><TextBlock Classes="muted" Text="Preview and remove legacy mod source trees or shader caches. Confirmed deletion cannot be undone."/></StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="150,260,20,150,260" RowDefinitions="Auto,8,Auto"><TextBlock Text="Source cleanup"/><ComboBox Grid.Column="1" ItemsSource="{Binding SourcePolicies}" SelectedItem="{Binding SourcePolicy}"/><TextBlock Grid.Column="3" Text="Shader cleanup"/><ComboBox Grid.Column="4" ItemsSource="{Binding ShaderPolicies}" SelectedItem="{Binding ShaderPolicy}"/><CheckBox Grid.Row="2" Grid.ColumnSpan="5" IsChecked="{Binding IncludeWorkshop}" Content="Include Steam Workshop installations (Steam may restore changed files)"/></Grid>
    <TextBlock Grid.Row="4" TextWrapping="Wrap" Text="CookedPCConsole mods retain source. Empty legacy shader cache means exactly 371 bytes. Preview is single-use, expires after 10 minutes, and is invalidated if content changes."/>
    <Grid Grid.Row="6" RowDefinitions="Auto,10,*"><WrapPanel><Button AutomationProperties.AutomationId="CleanupPreviewButton" Margin="0,0,8,8" Command="{Binding Preview}" Content="Preview cleanup"/><Button AutomationProperties.AutomationId="CleanupConfirmButton" Margin="0,0,8,8" Command="{Binding Confirm}" Content="Confirm deletion"/><Button Command="{Binding Cancel}" Content="Cancel"/></WrapPanel><TextBox AutomationProperties.AutomationId="CleanupReport" Grid.Row="2" Text="{Binding Report}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></Grid>
  </Grid>
</UserControl>
