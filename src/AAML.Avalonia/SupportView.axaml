<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AAML.Avalonia" x:Class="AAML.Avalonia.SupportView" x:DataType="local:SupportViewModel" AutomationProperties.AutomationId="SupportPage">
  <ScrollViewer><StackPanel Margin="28,12,28,28" MaxWidth="900" HorizontalAlignment="Left" Spacing="16">
    <StackPanel><TextBlock Classes="title" Text="Support" /><TextBlock Classes="muted" Text="Version, updates, local diagnostics, locations, and project resources." /></StackPanel>
    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto,6,Auto"><TextBlock Text="Product"/><TextBlock Grid.Column="1" Text="{Binding Product}"/><TextBlock Grid.Row="2" Text="Version"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Version}"/><TextBlock Grid.Row="4" Text="Runtime"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Runtime}"/><TextBlock Grid.Row="6" Text="Platform"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Platform}"/><TextBlock Grid.Row="8" Text="License"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding License}"/></Grid>
    <WrapPanel><Button AutomationProperties.AutomationId="SupportCheckUpdatesButton" Margin="0,0,8,8" Command="{Binding CheckUpdates}" Content="Check for updates"/><Button Margin="0,0,8,8" Command="{Binding OpenRelease}" Content="View release"/></WrapPanel>
    <TextBox AutomationProperties.AutomationId="SupportUpdateStatus" Text="{Binding UpdateDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    <TextBlock FontWeight="SemiBold" Text="Local diagnostics"/><TextBlock TextWrapping="Wrap" Text="AAML does not upload logs or crash reports. Review copied reports before sharing; user-provided mod names or exception text may remain."/><TextBlock Text="{Binding LogPath}"/>
    <WrapPanel><Button AutomationProperties.AutomationId="SupportCopyReportButton" Margin="0,0,8,8" Command="{Binding CopyReport}" Content="Copy diagnostic report"/><Button Margin="0,0,8,8" Command="{Binding OpenLog}" Content="Open active log"/><Button Margin="0,0,8,8" Command="{Binding OpenLogs}" Content="Open logs folder"/></WrapPanel>
    <TextBlock FontWeight="SemiBold" Text="AAML locations"/><WrapPanel><Button Margin="0,0,8,8" Command="{Binding OpenApplication}" Content="Application"/><Button Margin="0,0,8,8" Command="{Binding OpenConfig}" Content="Configuration"/><Button Margin="0,0,8,8" Command="{Binding OpenData}" Content="Data"/><Button Margin="0,0,8,8" Command="{Binding OpenState}" Content="State"/><Button Margin="0,0,8,8" Command="{Binding OpenCache}" Content="Cache"/><Button Margin="0,0,8,8" Command="{Binding OpenRuntime}" Content="Runtime"/></WrapPanel>
    <TextBlock FontWeight="SemiBold" Text="Selected game locations"/>
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Game-owned folders are opened only when they already exist; AAML never creates them."/>
    <WrapPanel>
      <Button AutomationProperties.AutomationId="SupportOpenGameInstallationButton" MinHeight="48" Margin="0,0,8,8" Command="{Binding OpenGame}" Content="Installation"/>
      <Button AutomationProperties.AutomationId="SupportOpenGameUserDataButton" MinHeight="48" Margin="0,0,8,8" Command="{Binding OpenGameUserData}" Content="User data"/>
      <Button AutomationProperties.AutomationId="SupportOpenGameConfigurationButton" MinHeight="48" Margin="0,0,8,8" Command="{Binding OpenGameConfiguration}" Content="Generated configuration"/>
      <Button AutomationProperties.AutomationId="SupportOpenGameLogButton" MinHeight="48" Margin="0,0,8,8" Command="{Binding OpenGameLog}" Content="Current log"/>
    </WrapPanel>
    <TextBlock FontWeight="SemiBold" Text="Project"/><WrapPanel><Button Margin="0,0,8,8" Command="{Binding OpenProject}" Content="Project page"/><Button Margin="0,0,8,8" Command="{Binding OpenIssues}" Content="Issue tracker"/><Button Margin="0,0,8,8" Command="{Binding OpenWiki}" Content="Wiki"/><Button Margin="0,0,8,8" Command="{Binding OpenLicense}" Content="View license"/></WrapPanel>
  </StackPanel></ScrollViewer>
</UserControl>
